from abc import ABC, abstractmethod

class Vehiculo(ABC):
    def __init__(self, marca, modelo):
        self.__marca = marca
        self.__modelo = modelo

    @abstractmethod
    def mover(self):
        pass

class Auto(Vehiculo):
    def mover(self):
        print("El auto está circulando.")

class Moto(Vehiculo):
    def mover(self):
        print("La moto está avanzando.")


vehiculos = [Auto("Toyota", "Corolla"),
             Moto("Yamaha", "R15")]

for vehiculo in vehiculos:
    vehiculo.mover()
